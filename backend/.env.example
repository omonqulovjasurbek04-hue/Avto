PORT=4000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL="file:./prisma/dev.db"
JWT_ACCESS_SECRET=change-me-min-32-chars-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ADMIN_MAX=30

# Cloudflare Stream — optional; leave blank while using the SVG simulation mode.
# Required only if/when real video upload+playback is wired in.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your-webhook-secret
