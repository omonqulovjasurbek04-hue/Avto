# ── Server ──────────────────────────────────────────────
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# ── Auth (JWT) ──────────────────────────────────────────
# Kamida 32 belgidan iborat murakkab kalit
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
# Token muddati: 7d (kun), 24h (soat), 60m (daqiqa)
JWT_EXPIRES_IN=7d

# ── Database (PostgreSQL) ──────────────────────────────
# Prisma migratsiya uchun majburiy. Auth va progress uchun kerak.
# Agar bo'sh qoldirilsa, auth ishlamaydi (503 qaytaradi)
DATABASE_URL=postgresql://postgres:password@localhost:5432/avto_db?schema=public

# ── CORS ────────────────────────────────────────────────
# Frontend URL lar vergul bilan ajratiladi
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate Limiting ───────────────────────────────────────
# 15 daqiqa oralig'idagi so'rovlar soni (ms)
RATE_LIMIT_WINDOW_MS=900000
# Umumiy limit (so'rovlar / window)
RATE_LIMIT_MAX=100
# Auth endpoint limit (so'rovlar / window)
RATE_LIMIT_AUTH_MAX=10
# Admin endpoint limit (so'rovlar / window)
RATE_LIMIT_ADMIN_MAX=30
