{
  "name": "yhq-platform",
  "version": "0.2.0",
  "private": true,
  "description": "AVTO (YHQ) monorepo: Node.js Express backend, Next.js + Tailwind frontend, React Native Expo mobile app.",
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @yhq/server",
    "dev:web": "npm run dev --workspace @yhq/web",
    "start:mobile": "npm run start --workspace @yhq/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
